#pragma kernel CSMain

// Source atlas texture
Texture2D<float4> SourceAtlas;
SamplerState samplerSourceAtlas;

// Output render texture
RWTexture2D<float4> Result;

// Sprite data struct
struct PaintData {
    float2 Position;
    float2 SpriteDimensions;
    float4 AtlasRegion;        // xy = offset, zw = size (normalized UV)
    float4 InvTransformMatrix;
};

StructuredBuffer<PaintData> _Data;
int2 OutputSize;
float2 RegionOffset;

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID) {
    float2 pixelPos = float2(id.x, id.y) + RegionOffset;
    if (pixelPos.x >= (uint)OutputSize.x || pixelPos.y >= (uint)OutputSize.y) return;

    // convert to splat space
    PaintData data = _Data[id.z];
    float2x2 invMatrix = float2x2(
        data.InvTransformMatrix.x,
        data.InvTransformMatrix.y,
        data.InvTransformMatrix.z,
        data.InvTransformMatrix.w
    );

    float2 centeredPixel = pixelPos - data.Position;
    float2 transformedPixel = mul(invMatrix, centeredPixel);
    
    float2 spriteUV = (transformedPixel / data.SpriteDimensions) + 0.5;
    if (spriteUV.x < 0 || spriteUV.x > 1 || spriteUV.y < 0 || spriteUV.y > 1) return;

    // Map to atlas region
    float2 atlasUV = data.AtlasRegion.xy + spriteUV * data.AtlasRegion.zw;
    uint width, height;
    SourceAtlas.GetDimensions(width, height);

    // Convert to pixel coords
    int2 pixelCoord = int2(atlasUV.x * width, atlasUV.y * height);
    float4 color = SourceAtlas.Load(int3(pixelCoord, 0));
    if (color.a == 0) return;
    Result[uint2(pixelPos)] = color;
}